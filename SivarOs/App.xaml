<Application
    x:Class="SivarOs.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Brand Colors (FluffyChat-inspired) -->
            <Color x:Key="BrandPrimary">#0075C9</Color>
            <Color x:Key="BrandBackground">#1A1A2E</Color>
            <Color x:Key="BrandSurface">#16213E</Color>
            <Color x:Key="BrandCard">#0F3460</Color>
            <Color x:Key="BrandText">#EAEAEA</Color>
            <Color x:Key="BrandSubtext">#9E9E9E</Color>
            <Color x:Key="BubbleOwn">#0075C9</Color>
            <Color x:Key="BubbleOther">#1E2D4F</Color>

            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}"/>
            <SolidColorBrush x:Key="BrandBackgroundBrush" Color="{StaticResource BrandBackground}"/>
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="{StaticResource BrandSurface}"/>
            <SolidColorBrush x:Key="BrandCardBrush" Color="{StaticResource BrandCard}"/>
            <SolidColorBrush x:Key="BrandTextBrush" Color="{StaticResource BrandText}"/>
            <SolidColorBrush x:Key="BrandSubtextBrush" Color="{StaticResource BrandSubtext}"/>
            <SolidColorBrush x:Key="BubbleOwnBrush" Color="{StaticResource BubbleOwn}"/>
            <SolidColorBrush x:Key="BubbleOtherBrush" Color="{StaticResource BubbleOther}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
